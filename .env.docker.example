MODEL_PROVIDER=mock
VECTOR_STORE=pgvector
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# For real OpenAI-compatible model gateways, switch MODEL_PROVIDER to openai-compatible
# and fill the values below in a local root .env file. Do not commit real secrets.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-thinking

# Optional: use a separate OpenAI-compatible endpoint/key for embeddings.
# Leave these blank to reuse LLM_BASE_URL and LLM_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# Optional single-user login gate.
AUTH_ENABLED=false
AUTH_EMAIL=demo@legal-rag.local
AUTH_NAME=演示用户
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=false
