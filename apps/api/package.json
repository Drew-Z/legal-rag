{
  "name": "@legal-rag/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "validate": "tsx src/validate.ts",
    "validate:pgvector": "tsx src/validate-pgvector.ts",
    "evaluate": "tsx src/evaluate.ts",
    "evaluate:review": "tsx src/evaluate-review.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@legal-rag/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
