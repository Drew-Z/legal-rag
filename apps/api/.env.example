PORT=4000
WEB_ORIGIN=http://localhost:5173
MODEL_PROVIDER=mock
VECTOR_STORE=memory

# OpenAI-compatible model gateway.
# Keep real secrets in apps/api/.env only; do not commit them.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-thinking

# Optional: use a separate OpenAI-compatible gateway for embeddings.
# Leave these empty to reuse LLM_BASE_URL and LLM_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# PostgreSQL + pgvector.
DATABASE_URL=

# Optional login gate. Leave disabled for local demos.
AUTH_ENABLED=false
AUTH_EMAIL=demo@legal-rag.local
AUTH_NAME=演示用户
AUTH_PASSWORD=
# Optional multi-user demo config. If set, AUTH_USERS_JSON replaces AUTH_EMAIL/AUTH_PASSWORD for login.
# AUTH_USERS_JSON=[{"email":"owner@example.com","name":"Owner","password":"strong-password"}]
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
