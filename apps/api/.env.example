PORT=4000
WEB_ORIGIN=http://localhost:5173
MODEL_PROVIDER=mock
VECTOR_STORE=memory

# OpenAI-compatible model gateway.
# Keep real secrets in apps/api/.env only; do not commit them.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-thinking

# Optional: use a separate OpenAI-compatible gateway for embeddings.
# Leave these empty to reuse LLM_BASE_URL and LLM_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# PostgreSQL + pgvector.
DATABASE_URL=
