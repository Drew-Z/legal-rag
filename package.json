{
  "name": "legal-rag",
  "private": true,
  "version": "0.1.0",
  "description": "Legal RAG MVP for legal Q&A and contract review.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace packages/shared run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "typecheck": "npm-run-all build:shared typecheck:api typecheck:web",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3"
  }
}
